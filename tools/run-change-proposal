#!/usr/bin/env bash
# Run the change-proposal harness under an interpreter new enough to parse it.
# The harness itself needs no third-party module -- it subprocesses the validator
# rather than importing it, so it cannot fail to import the way the validator did
# on a login node in 2026-08 -- but it uses `X | None` syntax, so a system python3
# predating 3.10 still cannot run it.
set -eu

here="${BASH_SOURCE[0]%/*}"
if [[ "$here" == "${BASH_SOURCE[0]}" ]]; then
    here="."
fi
here="$(cd -- "$here" && pwd)"

# The harness itself imports nothing third-party, but its suite step runs the tests in
# this same interpreter, and seven test modules import PyYAML and jsonschema in process
# to check schemas. Declaring them here is what keeps those checks running rather than
# skipping: `sys.executable` inside a tool launched this way inherits a dependency set
# something established, which is exactly the property a bare `python3` lacks.
exec "${BASH:-bash}" "$here/select-python" \
    --label "the change-proposal harness" \
    --allow-module-load \
    --require yaml \
    --require jsonschema \
    -- "$here/propose-change.py" "$@"

#!/usr/bin/env bash
# Run the batch-script checker under a Python 3.10+ interpreter. It is an operational
# tool: standard library only, reading the runtime-data projection rather than YAML
# (ARCHITECTURE.md §runtime-data). It still uses syntax a system python3 predating 3.10
# cannot parse, so it is never safe to invoke through a bare `python3`.
set -eu

# Resolve this script's directory with builtins only. `dirname` is external, and
# these runners must work under a minimal PATH: the session-logging runner is
# invoked from a user-level Stop hook in whatever environment the frontend
# provides, so depending on coreutils here breaks logging where PATH is bare.
here="${BASH_SOURCE[0]%/*}"
if [[ "$here" == "${BASH_SOURCE[0]}" ]]; then
    here="."
fi
here="$(cd -- "$here" && pwd)"

# Invoke through this same bash; see run-session-logging-python for why.
exec "${BASH:-bash}" "$here/select-python" \
    --label "the batch-script checker" \
    --allow-module-load \
    -- "$here/check-batch-script.py" "$@"

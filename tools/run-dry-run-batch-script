#!/usr/bin/env bash
# Run the batch-script dry-run harness under a Python 3.10+ interpreter. It and the
# checker it imports are operational tools, standard library only (ARCHITECTURE.md
# §runtime-data), but both use syntax a system python3 predating 3.10 cannot parse.
set -eu

here="${BASH_SOURCE[0]%/*}"
if [[ "$here" == "${BASH_SOURCE[0]}" ]]; then
    here="."
fi
here="$(cd -- "$here" && pwd)"

exec "${BASH:-bash}" "$here/select-python" \
    --label "the batch-script dry-run harness" \
    --allow-module-load \
    -- "$here/dry-run-batch-script.py" "$@"

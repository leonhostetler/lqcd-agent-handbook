#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${LQCD_HANDBOOK:-}" ]]; then
  printf '%s\n' \
    'LQCD_HANDBOOK is not set.' \
    'Set it to this handbook clone, for example:' \
    '  export LQCD_HANDBOOK=/path/to/lqcd-agent-handbook' >&2
  exit 2
fi

if ! handbook_root=$(realpath "$LQCD_HANDBOOK"); then
  printf 'Cannot resolve LQCD_HANDBOOK: %s\n' "$LQCD_HANDBOOK" >&2
  exit 2
fi
if [[ ! -f "$handbook_root/handbook.yaml" ||
      ! -f "$handbook_root/AGENTS.md" ||
      ! -f "$handbook_root/CLAUDE.md" ||
      ! -f "$handbook_root/.agents/skills/lqcd-start-session/SKILL.md" ]]; then
  printf 'LQCD_HANDBOOK does not identify a complete LQCD handbook: %s\n' \
    "$handbook_root" >&2
  exit 2
fi
if ! cmp -s "$handbook_root/AGENTS.md" "$handbook_root/CLAUDE.md"; then
  printf 'CLAUDE.md is not synchronized with canonical AGENTS.md. Run tools/sync-agent-entrypoints.py.\n' >&2
  exit 2
fi

codex_bootstrap='developer_instructions="The LQCD handbook launcher is active. Before project work, read and follow $LQCD_HANDBOOK/AGENTS.md, then follow $LQCD_HANDBOOK/playbooks/start-session-codex.md and $LQCD_HANDBOOK/playbooks/start-session.md. Keep all working-project AGENTS.md instructions active."'

export LQCD_HANDBOOK="$handbook_root"
export LQCD_HANDBOOK_LAUNCHED=1
export LQCD_HANDBOOK_FRONTEND=codex
export LQCD_HANDBOOK_CODEX_BOOTSTRAP=1
exec codex --add-dir "$handbook_root" --config "$codex_bootstrap" "$@"

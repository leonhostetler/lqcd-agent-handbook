#!/usr/bin/env bash
# Run the submission guard under a Python 3.10+ interpreter. It is an operational tool,
# standard library only (ARCHITECTURE.md §runtime-data), and imports the checker, whose
# `X | None` syntax an older python3 cannot parse.
set -eu

here="${BASH_SOURCE[0]%/*}"
if [[ "$here" == "${BASH_SOURCE[0]}" ]]; then
    here="."
fi
here="$(cd -- "$here" && pwd)"

exec "${BASH:-bash}" "$here/select-python" \
    --label "the submission guard" \
    --allow-module-load \
    -- "$here/submission-guard.py" "$@"
